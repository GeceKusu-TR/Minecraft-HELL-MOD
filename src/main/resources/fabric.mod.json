{
	"schemaVersion": 1,
	"id": "minecraftmod",
	"version": "${version}",
	"name": "Minecraft Hell Mode",
	"description": "Minecraft’s Most Brutal and Difficult Mode",
	"authors": [
		"Anonim"
	],
	"license": "CC0-1.0",
	"icon": "assets/minecraftmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.minecraftmod.MinecraftMod"
		],
		"client": [
			"com.example.minecraftmod.client.MinecraftModClient"
		]
	},
	"mixins": [
		"minecraftmod.mixins.json",
		{
			"config": "minecraftmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
